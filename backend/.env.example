# =================================================================
# Analyst_app Environment Variables Example (Backend)
# คัดลอกไฟล์นี้ไปเป็น .env ในโฟลเดอร์ backend และระบุค่าจริงของคุณ
# อย่า commit ไฟล์ .env — เก็บ secrets เฉพาะในเครื่องหรือ secret manager
# =================================================================

# --- App Configurations ---
PROJECT_NAME="SaaS AI Data Analysis API"
API_V1_STR="/api/v1"
# Phase 5 conversational data-setup (wizard remains available when false)
ENABLE_CONVERSATIONAL_DATA_SETUP=true
# Optional dedicated orchestrator model; empty uses LIGHT/FREE/PREMIUM routing
LLM_MODEL_ORCHESTRATOR=
MAX_ORCHESTRATOR_ACTIONS=3
# Phase 7 stuck-workflow diagnostics (no auto state changes)
WORKFLOW_RUNNING_STUCK_MINUTES=120
WORKFLOW_AWAITING_USER_STALE_HOURS=24
# Request timeout for chat endpoints (seconds). Default 180.
CHAT_REQUEST_TIMEOUT_SECONDS=300
# Supabase storage download timeout (seconds). Default 120 — large Excel/Parquet need more than 20s.
STORAGE_DOWNLOAD_TIMEOUT_SECONDS=300
SUPABASE_POSTGREST_TIMEOUT_SECONDS=300
ETL_SCHEDULER_ENABLED=true
ETL_SCHEDULER_POLL_SECONDS=30
ETL_SCHEDULER_BATCH_SIZE=3
ETL_SCHEDULER_LEASE_SECONDS=900

# External Python analytics sandbox (Pro/Deep). Keep disabled unless an
# isolated OCI/gVisor-compatible runner is deployed. Never point this at the
# FastAPI process and never expose the token to the browser.
PYTHON_SANDBOX_ENABLED=false
PYTHON_SANDBOX_RUNNER_URL=
PYTHON_SANDBOX_RUNNER_TOKEN=
PYTHON_SANDBOX_STAGE_DIR=data/python_sandbox_stage
PYTHON_SANDBOX_POLL_SECONDS=2
PYTHON_SANDBOX_MAX_CPU=2
PYTHON_SANDBOX_MAX_MEMORY_MB=2048
PYTHON_SANDBOX_MAX_RUNTIME_SECONDS=60
PYTHON_SANDBOX_MAX_INPUT_BYTES=524288000
PYTHON_SANDBOX_MAX_OUTPUT_BYTES=10485760
ETL_MAX_SCHEDULES_PER_USER=10
WORKER_HEARTBEAT_SECONDS=30

# Smart Alert worker (apply smart_alert_evaluator.sql before enabling)
SMART_ALERT_SCHEDULER_ENABLED=false
SMART_ALERT_POLL_SECONDS=30
SMART_ALERT_BATCH_SIZE=5
SMART_ALERT_LEASE_SECONDS=300
SMART_ALERT_DELIVERY_ATTEMPTS=2
SMART_ALERT_DELIVERY_TIMEOUT_SECONDS=15
# Server-side only; never expose these as NEXT_PUBLIC_* variables.
SMART_ALERT_SLACK_WEBHOOK_URL=
SMART_ALERT_TEAMS_WEBHOOK_URL=
SMART_ALERT_WEBHOOK_URL=

# Scheduled report delivery (server-side secrets only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MataQorLab
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Public HTTPS API origin used by the optional email open pixel
DELIVERY_PUBLIC_BASE_URL=http://localhost:8000
DELIVERY_LLM_ENABLED=true
DELIVERY_LLM_MAX_TOKENS=500
DELIVERY_TIMEOUT_SECONDS=30

# Autonomous agent (pause/resume sessions)
AGENT_SESSION_DIR=data/agent_sessions
AGENT_MAX_STEPS=5
AGENT_MAX_TOOL_CALLS_PER_QUESTION=6
AGENT_MAX_TOOL_COST_UNITS=12
AGENT_DF_CACHE_MAX_MB=50
AGENT_MAX_LLM_CALLS_PER_QUESTION=10
DUCKDB_ROW_THRESHOLD=50000
EXTENDED_ANALYTICS_ROW_THRESHOLD=1000000
MAX_EXCEL_FILE_BYTES=25000000
MAX_LLM_METRICS_CHARS=12000
DATASET_INGEST_CACHE_DIR=data/dataset_cache
ANALYTICS_DISK_CACHE_DIR=data/analytics_cache
API_FETCH_TIMEOUT_SECONDS=120
API_PAGINATION_MAX_PAGES=10000
EXCEL_STREAMING_BYTES_THRESHOLD=2000000
MAX_UPLOAD_FILE_BYTES=524288000
# Max rows for DB sync dumps and live SELECT (unified policy)
SQL_SYNC_ROW_LIMIT=10000000
MAX_SQL_RESULT_ROWS=10000000
SQL_QUERY_TIMEOUT_SECONDS=300
SQL_STREAM_CHUNK_SIZE=25000
ANALYTICS_CACHE_TTL_SECONDS=1800

# Agent session: file (single server) or supabase (multi-instance; run supabase/agent_sessions.sql)
# Column mapping memory: run supabase/column_mappings_memory.sql
AGENT_SESSION_BACKEND=file
AGENT_SESSION_STORAGE_BUCKET=business-data

# Cloud spreadsheet connections keep source files at Google/Microsoft.
# Links must be HTTPS share/download links accessible by the backend.

# --- LLM provider (OpenAI-compatible: OpenRouter, Groq, Together, etc.) ---
# Default setup uses OpenRouter — https://openrouter.ai/
LLM_API_KEY=your-llm-api-key
LLM_MODEL_FREE=openai/gpt-oss-120b:free
LLM_MODEL_FREE_FALLBACK=google/gemma-4-26b-a4b-it:free
LLM_MODEL_PREMIUM=google/gemma-4-31b-it:free
LLM_MODEL_PREMIUM_FALLBACK=nousresearch/hermes-3-llama-3.1-405b:free
LLM_MODEL_LIGHT=
LLM_MODEL_REASONING=
LLM_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter hosting provider — applies to LLM_MODEL_FREE / LLM_MODEL_PREMIUM only (not *_FALLBACK)
# LLM_PROVIDER_ORDER=deepinfra
# LLM_PROVIDER_ONLY=deepinfra
# LLM_PROVIDER_ALLOW_FALLBACKS=false
# Legacy names still supported: OPENROUTER_API_KEY, OPENROUTER_BASE_URL, OPENROUTER_MODEL_*
APP_REFERER=https://github.com/your-org/your-repo
APP_TITLE="Analyst AI App"

# --- Supabase Configurations ---
# Project URL + keys: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Legacy alias still supported: VITE_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Generate once: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep the same value across every backend/worker replica. Rotating it requires re-encrypting stored connections.
CONNECTION_SECRET_KEY=
# Keep both false on public SaaS hosts. Private/on-prem connectors should use a controlled connector agent/VPC.
ALLOW_PRIVATE_CONNECTORS=false
ALLOW_INSECURE_HTTP_CONNECTORS=false

# --- Stripe Configurations ---
# Required for paid/Enterprise production checkout. Webhooks fail closed without whsec.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
FRONTEND_URL=http://localhost:3000
# Comma-separated origins allowed to call the API (defaults to FRONTEND_URL + local dev ports)
# CORS_ORIGINS=https://app.example.com,https://www.example.com
